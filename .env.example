# Server-side only. Set this in .env.local for npm run dev:netlify,
# or in Netlify environment variables with Functions scope for production.
# Never prefix this secret with VITE_. The curated demo works without it.
RAWG_API_KEY=

# Optional local server ports; npm run dev also accepts --port / --target-port.
# CHECKPOINT_PORT=8888
# CHECKPOINT_VITE_PORT=5173
